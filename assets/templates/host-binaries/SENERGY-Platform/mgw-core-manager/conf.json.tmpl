{
  "socket": {
    "path": "${SOCKETS_PATH}/c_manager.sock",
    "group_id": 101
  },
  "logger": {
    "path": "${LOG_PATH}",
    "file_name": "c_manager"
  },
  "http_client": {
    "cew_socket_path": "${SOCKETS_PATH}/ce_wrapper.sock"
  },
  "endpoints_conf_path": "${MOUNTS_PATH}/nginx/dep_endpoints.location",
  "compose_file_path": "${CONFIG_PATH}/container/docker-compose.yml",
  "core_id": "${CORE_ID}",
  "core_service": {
    "gateway_srv_name": "nginx"
  },
  "kratos": {
    "version": "${KRATOS_VERSION}",
    "config_path": "${MOUNTS_PATH}/kratos/config.json",
    "file_uid": 10000
  },
  "log_handler": {
    "path": "${CONFIG_PATH}/host-binaries/SENERGY-Platform/mgw-core-manager/log_hdl.json"
  },
  "state_files": {
    "version_path": "${ASSETS_PATH}/version",
    "update_path": "${STATE_PATH}/update",
    "check_path": "${STATE_PATH}/check",
    "lock_path": "${STATE_PATH}/lock"
  },
  "containers": {
    "wait_sockets": ["${SOCKETS_PATH}/ce_wrapper.sock", "${SOCKETS_PATH}/h_manager.sock"]
  }
}
