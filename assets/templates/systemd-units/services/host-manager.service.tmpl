[Unit]
Description=${CORE_NAME} host manager
PartOf=${CORE_NAME}-ce-wrapper.service
After=docker.service ${CORE_NAME}-recover.service
Requires=${CORE_NAME}-recover.service

[Service]
ExecStart=${BIN_PATH}/SENERGY-Platform/mgw-host-manager/bin -config=${CONFIG_PATH}/host-binaries/SENERGY-Platform/mgw-host-manager/conf.json
Restart=always

[Install]
WantedBy=default.target
