services:
  nginx:
    container_name: ${CORE_NAME}-nginx
    image: ${NGINX_IMG}
    restart: "${CTR_RESTART_POLICY}"
    environment:
      CORE_ID: "${CORE_ID}"
      SUBNET_CORE: ${SUBNET_CORE}
      SUBNET_MODULE: ${SUBNET_MODULE}
      SUBNET_GATEWAY: ${SUBNET_GATEWAY}
      GATEWAY_PORT: ${GATEWAY_PORT}
    labels:
      mgw_cid: "${CORE_ID}"
      core_srv: "true"
    volumes:
      - ${CONTAINER_PATH}/configs/gateway/conf/upstream.conf:/etc/nginx/conf.d/upstream.conf:ro
      - ${MOUNTS_PATH}/nginx:/etc/nginx/conf.d/public_api:ro
      - ${CONTAINER_PATH}/configs/gateway/template:/etc/nginx/templates:ro
      - ${SOCKETS_PATH}:/opt/core/sockets
    ports:
      - ${GATEWAY_PORT}:${GATEWAY_PORT}/tcp
      - ${GATEWAY_PORT}:${GATEWAY_PORT}/udp
    networks:
      g_net:
      c_net:
        aliases:
          - core-api
      m_net:
        aliases:
          - core-api
  mysqldb:
    container_name: ${CORE_NAME}-mysqldb
    image: ${MYSQLDB_IMG}
    restart: "${CTR_RESTART_POLICY}"
    environment:
      MYSQL_USER: core_user
      MYSQL_PASSWORD: ${CORE_DB_PW}
      MYSQL_ROOT_PASSWORD: ${CORE_DB_ROOT_PW}
    labels:
      mgw_cid: "${CORE_ID}"
      core_srv: "true"
    volumes:
      - mysqldb-data:/var/lib/mysql
      - ${CONTAINER_PATH}/configs/db/init:/docker-entrypoint-initdb.d:ro
      - ${CONTAINER_PATH}/configs/db/conf:/etc/mysql/conf.d:ro
    networks:
      c_net:
        aliases:
          - core-db
  kratos:
    container_name: ${CORE_NAME}-kratos
    image: ${KRATOS_IMG}
    restart: "${CTR_RESTART_POLICY}"
    depends_on:
      - mysqldb
      - kratos-migrate
    environment:
      DSN: mysql://core_user:${CORE_DB_PW}@tcp(core-db:3306)/kratos?max_conns=20&max_idle_conns=4
      LOG_LEVEL: ${KRATOS_LOG_LEVEL}
    labels:
      mgw_cid: "${CORE_ID}"
      core_srv: "true"
    # TODO remove --dev flag -->
    command: serve -c /etc/config/kratos/config.json -c /etc/config/kratos-dyn/config.json --dev --watch-courier
    # TODO <-- remove --dev flag
    volumes:
      - ${CONTAINER_PATH}/configs/identity-server:/etc/config/kratos:ro
      - ${MOUNTS_PATH}/kratos:/etc/config/kratos-dyn:ro
      - kratos-home:/home/ory
      - kratos-data:/var/lib/sqlite
    networks:
      c_net:
        aliases:
          - identity-server
  kratos-migrate:
    container_name: ${CORE_NAME}-kratos-migrate
    image: ${KRATOS_IMG}
    restart: on-failure
    depends_on:
      - mysqldb
    environment:
      DSN: mysql://core_user:${CORE_DB_PW}@tcp(core-db:3306)/kratos?max_conns=20&max_idle_conns=4
      LOG_LEVEL: ${KRATOS_MIGRATE_LOG_LEVEL}
    labels:
      mgw_cid: "${CORE_ID}"
      core_srv: "true"
    command: -c /etc/config/kratos/config.json -c /etc/config/kratos-dyn/config.json migrate sql -e --yes
    volumes:
      - ${CONTAINER_PATH}/configs/identity-server:/etc/config/kratos:ro
      - ${MOUNTS_PATH}/kratos:/etc/config/kratos-dyn:ro
      - kratosm-home:/home/ory
      - kratosm-data:/var/lib/sqlite
    networks:
      c_net:
  auth-service:
    container_name: ${CORE_NAME}-auth-service
    image: ${AUTH_SERVICE_IMG}
    restart: "${CTR_RESTART_POLICY}"
    depends_on:
      - kratos
    environment:
      LOGGER_LEVEL: ${AUTH_SERVICE_LOG_LEVEL}
      LOGGER_TERMINAL: "true"
      CORE_ID: "${CORE_ID}"
      IDENTITY_SRV_BASE_URL: http://identity-server:4434
      II_USER: ${CORE_USR}
      II_SECRET: ${CORE_USR_PW}
    labels:
      mgw_cid: "${CORE_ID}"
      core_srv: "true"
    networks:
      c_net:
  module-manager-migration:
    container_name: ${CORE_NAME}-module-manager-migration
    image: ${MODULE_MANAGER_MIGRATION_IMG}
    restart: on-failure
    depends_on:
      - mysqldb
      - nginx
    environment:
      CEW_BASE_URL: "http://core-api/ce-wrapper"
      DATABASE_ADDRESS: "core-db:3306"
      DATABASE_USER: core_user
      DATABASE_PASSWORD: ${CORE_DB_PW}
    labels:
      mgw_cid: "${CORE_ID}"
      core_srv: "true"
    volumes:
      - mm-data:/opt/module-manager/data
      - mm-service:/opt/module-manager/service
      - mm-modules:/opt/module-manager/modules
      - ${DEPLOYMENTS_PATH}:/opt/module-manager/deployments
    networks:
      c_net:
  module-manager:
    container_name: ${CORE_NAME}-module-manager
#    image: ${MODULE_MANAGER_IMG}
    build:
      context: https://github.com/SENERGY-Platform/mgw-module-manager.git
      args:
        - VERSION
    image: mgw-module-manager:dev
    restart: "${CTR_RESTART_POLICY}"
    depends_on:
      module-manager-migration:
        condition: service_completed_successfully
      mysqldb:
        condition: service_started
      nginx:
        condition: service_started
      secret-manager:
        condition: service_started
    environment:
      CORE_ID: "${CORE_ID}"
      MODULE_CONTAINER_NETWORK: ${CORE_NAME}-2-module-net
      HOST_DEPLOYMENTS_PATH: ${DEPLOYMENTS_PATH}
      HOST_SECRETS_PATH: ${SECRETS_PATH}
      LOGGER_LEVEL: ${MODULE_MANAGER_LOG_LEVEL}
      HTTP_ACCESS_LOG: ${MODULE_MANGER_HTTP_ACCESS_LOG}
      MGW_CEW_BASE_URL: "http://core-api/ce-wrapper"
      MGW_CM_BASE_URL: "http://core-api/c-manager"
      MGW_HM_BASE_URL: "http://core-api/h-manager"
      MGW_SM_BASE_URL: "http://secret-manager"
      DATABASE_ADDRESS: "core-db:3306"
      DATABASE_USER: core_user
      DATABASE_PASSWORD: ${CORE_DB_PW}
      DEPLOYMENTS_HANDLER_RUNTIME_MONITOR_STARTUP_DELAY: ${MODULE_MANAGER_DEP_STARTUP_DELAY}
      AUX_DEPLOYMENTS_HANDLER_RUNTIME_MONITOR_STARTUP_DELAY: ${MODULE_MANAGER_AUX_DEP_STARTUP_DELAY}
    labels:
      mgw_cid: "${CORE_ID}"
      core_srv: "true"
    volumes:
      - mm-service:/opt/module-manager/service
      - mm-modules:/opt/module-manager/modules
      - mm-repo-github-user-sources:/opt/module-manager/repositories/github/user_sources
      - ${CONTAINER_PATH}/configs/module-manager/repo-github-default-sources:/opt/module-manager/repositories/github/default_sources
      - mm-repo-github-repositories:/opt/module-manager/repositories/github/repositories
      - ${HOST_DIR_REPOSITORY_PATH}:/opt/module-manager/repositories/host_dir
      - ${DEPLOYMENTS_PATH}:/opt/module-manager/deployments
    networks:
      c_net:
  secret-manager:
    container_name: ${CORE_NAME}-secret-manager
    image: ${SECRET_MANAGER_IMG}
    restart: "${CTR_RESTART_POLICY}"
    depends_on:
      - mysqldb
    environment:
      TMPFS_PATH: /tmp
      ENABLE_ENCRYPTION: "false"
      EXPOSE_CONFIDENTIAL_ENDPOINTS: "true"
      DB_CONNECTION_URL: core_user:${CORE_DB_PW}@tcp(core-db:3306)/secret_manager
      MASTER_KEY_FILE_PATH: /opt/data/key
      SERVER_PORT: 80
      LOGGER_LEVEL: ${SECRET_MANAGER_LOG_LEVEL}
      LOGGER_TERMINAL: "true"
    labels:
      mgw_cid: "${CORE_ID}"
      core_srv: "true"
    volumes:
      - ${SECRETS_PATH}:/tmp
      - sm-data:/opt/data
    networks:
      c_net:
  web-ui:
    container_name: ${CORE_NAME}-web-ui
#    image: ${WEB_UI_IMG}
    build:
      context: https://github.com/SENERGY-Platform/mgw-gui.git#next-gen
      dockerfile: build/Dockerfile
      args:
        - VERSION
    image: mgw-gui:dev
    restart: "${CTR_RESTART_POLICY}"
    labels:
      mgw_cid: "${CORE_ID}"
      core_srv: "true"
    depends_on:
      - nginx
      - auth-service
      - module-manager
      - secret-manager
    networks:
      m_net:

volumes:
  mm-data:
  mm-service:
  mm-modules:
  mm-repo-github-user-sources:
  mm-repo-github-repositories:
  sm-data:
  mysqldb-data:
  kratos-home:
  kratosm-home:
  kratos-data:
  kratosm-data:

networks:
  g_net:
    name: ${CORE_NAME}-0-gateway-net
    attachable: true
    driver: bridge
    ipam:
      driver: default
      config:
        - subnet: ${SUBNET_GATEWAY}/28
  c_net:
    name: ${CORE_NAME}-1-core-net
    attachable: true
    driver: bridge
    ipam:
      driver: default
      config:
        - subnet: ${SUBNET_CORE}/28
  m_net:
    name: ${CORE_NAME}-2-module-net
    attachable: true
    driver: bridge
    ipam:
      driver: default
      config:
        - subnet: ${SUBNET_MODULE}/16
