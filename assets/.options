require_pkg="apt:"
require_pkg_systemd="systemctl:"
install_pkg="curl: tar: gzip: jq: openssl: gettext-base:envsubst"
install_pkg_logrotate="logrotate:/usr/sbin/logrotate"
install_pkg_cron="cron:/usr/sbin/cron"
install_pkg_advertise="avahi-daemon:/usr/sbin/avahi-daemon"
# temporary: every core updated to this release joins the platform's netbird,
# see handleNetbird in update.sh. the key is public with the release archive,
# so it only lives as long as the rollout needs it
netbird_version="v0.82.0"
netbird_management_url="https://netbird.smartador.com"
netbird_setup_key="93D7B9FA-E60B-40B5-900C-AC387F9E8E0F"
binaries="
SENERGY-Platform/mgw-container-engine-wrapper:v0.18.3
SENERGY-Platform/mgw-host-manager:v1.5.5
SENERGY-Platform/mgw-core-manager:v0.19.0
"
images="
NGINX_IMG=nginx:1.31.1-alpine
MYSQLDB_IMG=mysql:8.4.9
KRATOS_IMG=oryd/kratos:v1.3.1
AUTH_SERVICE_IMG=ghcr.io/senergy-platform/mgw-auth-service:0.3.2
MODULE_MANAGER_IMG=ghcr.io/senergy-platform/mgw-module-manager:0.53.0
MODULE_MANAGER_MIGRATION_IMG=ghcr.io/senergy-platform/mgw-module-manager-migration:0.2.2
SECRET_MANAGER_IMG=ghcr.io/senergy-platform/mgw-secret-manager:0.6.1
WEB_UI_IMG=ghcr.io/senergy-platform/mgw-gui:v3.3.0
"